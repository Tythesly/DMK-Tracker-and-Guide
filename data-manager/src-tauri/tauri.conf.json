{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DMK Data Manager",
  "version": "0.1.0",
  "identifier": "com.tythesly.dmkdatamanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DMK Data Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "maximized": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}